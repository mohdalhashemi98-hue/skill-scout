# =============================================================================
# Skill Scout - Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before running docker compose.
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d
#
# IMPORTANT: Never commit the .env file to version control.
# =============================================================================

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================

# Primary domain for the n8n instance (must point to your server's IP via DNS)
N8N_HOST=n8n.yourdomain.com

# Subdomain for the monitoring dashboard
MONITORING_HOST=status.yourdomain.com

# Email for Let's Encrypt certificate registration (receives expiry warnings)
ACME_EMAIL=admin@yourdomain.com

# Timezone for all services (IANA format)
TIMEZONE=UTC

# =============================================================================
# n8n CONFIGURATION
# =============================================================================

# Encryption key for n8n credential storage.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# n8n admin login credentials (used for the web editor UI)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_use_a_strong_password

# =============================================================================
# POSTGRESQL (n8n internal database)
# =============================================================================
# This database stores n8n workflows, credentials, and execution history.
# It is NOT the Supabase database used by client applications.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
POSTGRES_DB=n8n

# =============================================================================
# REDIS (n8n queue mode backend)
# =============================================================================

# Password for the Redis instance.
# Generate with: openssl rand -hex 16
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_16

# =============================================================================
# SUPABASE (client data platform)
# =============================================================================
# These credentials connect n8n workflows to your Supabase project where
# client data, conversations, files, and usage metrics are stored.

# Your Supabase project URL (found in Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous key (safe for client-side, limited by RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase service role key (full database access, KEEP SECRET)
# Found in Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# =============================================================================
# AI / LLM CONFIGURATION
# =============================================================================

# Anthropic API key for Claude (used by AI Agent nodes in n8n workflows)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Default model for AI agents (can be overridden per workflow)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# TELEGRAM BOT
# =============================================================================

# Bot token from @BotFather on Telegram
# Create a bot: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# =============================================================================
# WHATSAPP BUSINESS API
# =============================================================================
# For WhatsApp integration via the Meta Cloud API.
# Set up at: https://developers.facebook.com/apps/

# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Phone number ID (from the WhatsApp section of your Meta app)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Permanent access token (System User token recommended for production)
WHATSAPP_ACCESS_TOKEN=your-access-token

# Webhook verify token (you define this; must match Meta app webhook config)
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token

# =============================================================================
# CLIENT CONFIGURATION (default client for single-tenant setups)
# =============================================================================

# API key of the default client (must match a row in the clients table)
CLIENT_API_KEY=your-client-api-key

# UUID of the default client
CLIENT_ID=00000000-0000-0000-0000-000000000000
